# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# Database Configuration
# For local SQLite (Default, zero external setup):
DATABASE_URL=sqlite+aiosqlite:///./eve_healthcare.db
# For PostgreSQL (Docker or production):
# DATABASE_URL=postgresql+asyncpg://eve_user:eve_password@localhost:5432/eve_healthcare

# JWT Authentication
SECRET_KEY=eve-healthcare-super-secret-jwt-signing-key-change-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Webhook Secret (optional verification)
WEBHOOK_SECRET=eve_webhook_secret_key
